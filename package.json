{
  "name": "text-binary-converter",
  "version": "1.0.1",
  "description": "Convert text to binary string and back (UTF-8). Zero dependencies.",
  "keywords": ["binary", "text", "convert", "encode", "utf8", "utf-8"],
  "author": "MaxGrushevsky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maksimgrushevsky/text-to-binary.git"
  },
  "homepage": "https://github.com/maksimgrushevsky/text-to-binary#readme",
  "bugs": {
    "url": "https://github.com/maksimgrushevsky/text-to-binary/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
